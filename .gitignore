!/Build/Steam/*.example.vdf
/Build/Steam/*.local.vdf
/Build/Steam/sdk/
/Build/Steam/output/
steam_appid.txt
ssfn*
config.vdf
loginusers.vdf
.env
.env.*
!.env.example
*.pfx
*.p12

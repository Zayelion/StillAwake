  "story": [
    {
      "fragmentId": "journal_arrival",
      "title": "A familiar house",
      "unlockAfterRounds": 0.0,
      "text": "I came back because I thought I would sleep here.\n\nThe curtains are drawn. The stove is off. There are clean dishes in the sink.\n\nMake one circuit. Leave a Fix it note where something has changed. Then go to bed."
    },
    {
      "fragmentId": "journal_counting",
      "title": "Counting",
      "unlockAfterRounds": 0.0,
      "text": "A white cat and a black cat in the foyer. A pale towel on the rail. A doll facing the room.\n\nI wrote these things down so that I would not have to remember. Now I cannot remember writing them."
    },
    {
      "fragmentId": "journal_letter",
      "title": "The letter",
      "unlockAfterRounds": 1.0,
      "text": "You said the house would feel smaller when I came home.\n\nYou were wrong about that.\n\nThere is still a place set for you. I keep telling myself that is ordinary."
    },
    {
      "fragmentId": "journal_clock",
      "title": "Three minutes",
      "unlockAfterRounds": 1.0,
      "text": "The clock has not moved. I have.\n\nWhen I come up the stairs, I hear someone settle in the room beyond the landing. I keep my hand on the railing until the sound passes."
    },
    {
      "fragmentId": "journal_handwriting",
      "title": "In my handwriting",
      "unlockAfterRounds": 2.0,
      "text": "I found another list under the lamp. It says I can stop looking.\n\nIt is in my handwriting. I don't remember leaving it there."
    },
    {
      "fragmentId": "journal_morning",
      "title": "The window",
      "unlockAfterRounds": 3.0,
      "text": "There is a pale line beneath the curtain.\n\nMaybe morning has been waiting outside all this time. Maybe it is only the streetlight.\n\nI would like to sleep without knowing."
    }
  ],
  "endingLine": "At dawn I heard the pipes settle. I left my slippers beside the bed.",
  "walkSpeed": 300
}
